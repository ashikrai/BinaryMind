# ─── Google OAuth ────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application type)
# 3. Add your dev origin to "Authorized JavaScript origins", e.g.:
#      http://localhost:8080
# 4. Copy the Client ID below

VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# ─── Supabase ─────────────────────────────────────────────────────────────────
# 1. Go to https://supabase.com/dashboard → your project → Settings → API
# 2. Copy "Project URL" and "anon public" key below
# 3. Run supabase/schema.sql in the Supabase SQL editor to create tables

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
